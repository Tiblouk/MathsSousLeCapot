<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MathsSousLeCapot.App.Controls.CourseNavigation"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MathsSousLeCapot.App.Localization">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Grid.Column="0" Text="{loc:Translate navigation.previous}" />
        <Button Grid.Column="1" Text="{loc:Translate navigation.next}" />
    </Grid>
</ContentView>
