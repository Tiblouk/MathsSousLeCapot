<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>
    <Style TargetType="Shell">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
        <Setter Property="ForegroundColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="DisabledColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="UnselectedColor" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style x:Key="SchoolGroupDisclosureButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryLight}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style x:Key="LevelDisclosureButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="18,13" />
    </Style>
    <Style x:Key="CategoryDisclosureButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{DynamicResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource Border}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="SuccessFeedback" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource Success}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="ErrorFeedback" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource ErrorBackground}" />
        <Setter Property="Stroke" Value="{DynamicResource Error}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14" />
    </Style>
</ResourceDictionary>
