<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="MathsSousLeCapot.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:courses="clr-namespace:MathsSousLeCapot.App.Features.Courses"
    xmlns:loc="clr-namespace:MathsSousLeCapot.App.Localization"
    BackgroundColor="{StaticResource Background}"
    FlyoutBehavior="Disabled"
    ForegroundColor="{StaticResource TextPrimary}"
    Title="{loc:Translate app.title}">
    <ShellContent
        ContentTemplate="{DataTemplate courses:ChapterPage}"
        Route="understand-numbers"
        Title="{loc:Translate app.title}" />
</Shell>
