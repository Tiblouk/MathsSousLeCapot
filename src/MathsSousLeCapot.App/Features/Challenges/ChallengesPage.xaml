<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathsSousLeCapot.App.Features.Challenges.ChallengesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MathsSousLeCapot.App.Localization"
    Title="{loc:Translate challenge.title}">
    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="850"
            Padding="24,28,24,40"
            Spacing="20">
            <Button
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                Style="{StaticResource SecondaryButton}"
                Text="{loc:Translate navigation.courseList}" />
            <Label Style="{StaticResource PageTitle}" Text="{loc:Translate challenge.title}" />
            <Label
                x:Name="ProfileLabel"
                TextColor="{DynamicResource TextSecondary}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="{loc:Translate challenge.totalScore}"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label
                        x:Name="TotalScoreLabel"
                        FontAttributes="Bold"
                        FontSize="42"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource Primary}" />
                    <Label
                        x:Name="ScoreDetailsLabel"
                        HorizontalTextAlignment="Center"
                        TextColor="{DynamicResource TextSecondary}" />
                    <Label
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        Text="{loc:Translate challenge.trainingRule}"
                        TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate challenge.listTitle}" />
            <VerticalStackLayout x:Name="ChallengesPanel" Spacing="12" />

            <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate challenge.leaderboardTitle}" />
            <Label
                Text="{loc:Translate challenge.leaderboardDescription}"
                TextColor="{DynamicResource TextSecondary}" />
            <VerticalStackLayout x:Name="LeaderboardPanel" Spacing="10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
