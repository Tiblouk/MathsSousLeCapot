<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MathsSousLeCapot.App.Features.Profiles.ProfilesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:MathsSousLeCapot.App.Localization"
    Title="{loc:Translate profile.title}">
    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="800"
            Padding="24,28,24,40"
            Spacing="20">
            <Button
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                Style="{StaticResource SecondaryButton}"
                Text="{loc:Translate navigation.courseList}" />
            <Label Style="{StaticResource PageTitle}" Text="{loc:Translate profile.title}" />
            <Label
                Text="{loc:Translate profile.description}"
                TextColor="{DynamicResource TextSecondary}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate profile.createTitle}" />
                    <Entry
                        x:Name="ProfileNameEntry"
                        MaxLength="30"
                        Placeholder="{loc:Translate profile.namePlaceholder}" />
                    <Button Clicked="OnCreateClicked" Text="{loc:Translate profile.create}" />
                </VerticalStackLayout>
            </Border>

            <Label Style="{StaticResource SectionTitle}" Text="{loc:Translate profile.localProfiles}" />
            <VerticalStackLayout x:Name="ProfilesPanel" Spacing="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
